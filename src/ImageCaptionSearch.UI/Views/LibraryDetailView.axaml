<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ImageCaptionSearch.UI.ViewModels"
             xmlns:conv="using:ImageCaptionSearch.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ImageCaptionSearch.UI.Views.LibraryDetailView"
             x:DataType="vm:LibraryDetailViewModel">

    <UserControl.Resources>
        <conv:BitmapValueConverter x:Key="BitmapConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        
        <!-- Header / Back -->
        <Border Padding="24,24,24,0">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <Button Command="{Binding NavigateBackCommand}" 
                        Background="Transparent" Padding="8">
                    <PathIcon Data="{StaticResource FolderIcon}" Width="20" Height="20" Foreground="#666666"/>
                </Button>
                <TextBlock Text="{Binding LibraryName}" 
                           FontSize="24" FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="1" Padding="24,20">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Text="{Binding SearchText}" 
                         Watermark="Search your images..."
                         Height="48" CornerRadius="24"
                         Padding="16,0,48,0"
                         VerticalContentAlignment="Center"
                         Classes="modern">
                    <TextBox.InnerRightContent>
                        <Button Command="{Binding SearchCommand}" 
                                Background="Transparent" 
                                Padding="12">
                            <PathIcon Data="{StaticResource SearchIconCorrect}" Width="16" Height="16"/>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0">
                    <ToggleButton IsChecked="{Binding IsCaptionSearchSelected}" 
                                  Content="Caption Search" Padding="12,8"
                                  CornerRadius="20"/>
                    <ToggleButton IsChecked="{Binding IsSemanticSearchSelected}" 
                                  Content="Semantic Search" Padding="12,8"
                                  CornerRadius="20"/>
                </StackPanel>

                <Button Grid.Column="2" 
                        Command="{Binding SearchCommand}" 
                        Content="Search" 
                        Classes="accent"
                        Padding="24,12" CornerRadius="24" />
            </Grid>
        </Border>

        <!-- Face Recognition Warning -->
        <Border Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top" 
                IsVisible="{Binding ShowFaceWarning}" 
                Background="#fffbe6" BorderBrush="#ffe58f" BorderThickness="0,0,0,1" Height="40" Padding="24,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource ErrorIcon}" Width="14" Height="14" Foreground="#faad14"/>
                <TextBlock Text="Face detection is enabled but model files are missing or invalid. Check settings." FontSize="12" Foreground="#856404"/>
            </StackPanel>
        </Border>

        <!-- Indexing Status Bar -->
        <Border Grid.Row="2" Margin="24,0,24,12" Padding="20,12" 
                Background="#f8f9fa" CornerRadius="12"
                IsVisible="{Binding Progress.IsRunning}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource AddIcon}" Width="16" Height="16" Foreground="#4a90e2"/>
                    <TextBlock Text="Indexing Library..." VerticalAlignment="Center" FontWeight="Medium"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center" Margin="24,0">
                    <TextBlock Text="{Binding Progress.CurrentFileName}" FontSize="12" Foreground="#666666" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Minimum="0" Maximum="{Binding Progress.TotalCount}" 
                                 Value="{Binding Progress.ProcessedCount}" 
                                 Width="200" Height="4"/>
                    <TextBlock Text="{Binding Progress.ProcessedCount}" FontSize="12" Foreground="#4a90e2" FontWeight="SemiBold"/>
                    <TextBlock Text="/" FontSize="12" Foreground="#999999"/>
                    <TextBlock Text="{Binding Progress.TotalCount}" FontSize="12" Foreground="#666666"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button IsVisible="{Binding !Progress.IsPaused}" Command="{Binding PauseIndexingCommand}" Padding="8,4">Pause</Button>
                    <Button IsVisible="{Binding Progress.IsPaused}" Command="{Binding ResumeIndexingCommand}" Padding="8,4">Resume</Button>
                    <Button Command="{Binding CancelIndexingCommand}" Padding="8,4">Stop</Button>
                </StackPanel>

                <Button Grid.Column="3" Margin="12,0,0,0" IsVisible="{Binding !Progress.IsRunning}" Command="{Binding StartIndexingCommand}">Start Indexing</Button>
            </Grid>
        </Border>

        <!-- Result Grid -->
        <ScrollViewer Grid.Row="3" Padding="24,0,24,24">
            <ListBox ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchResultViewModel">
                        <Border Width="180" Height="220" Margin="0" 
                                Background="White" CornerRadius="12" 
                                BoxShadow="0 2 8 0 #0f000000" ClipToBounds="True">
                             <Grid RowDefinitions="*,64">
                                <!-- Thumbnail -->
                                <Image Grid.Row="0" Source="{Binding ThumbnailPath, Converter={StaticResource BitmapConverter}}" Stretch="UniformToFill" />
                                
                                <!-- Metadata -->
                                <Border Grid.Row="1" Padding="12,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Caption}" FontSize="12" FontWeight="Medium" 
                                                   MaxLines="2" TextTrimming="CharacterEllipsis" 
                                                   Foreground="#333333"/>
                                        <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="#999999" 
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                             </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

    </Grid>
</UserControl>
